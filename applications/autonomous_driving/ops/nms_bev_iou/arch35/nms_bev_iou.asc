/*!
 * \file nms_bev_iou.asc
 * \brief NMS-BEV IoU matrix operator for Ascend NPU (dav-3510 / arch35).
 *
 * torch.ops.ops_multimodal_fusion.nms_bev_iou(Tensor boxes_bev) -> Tensor
 *   boxes_bev : (num_boxes, 7) fp32 [cx, cy, cz, dx, dy, dz, yaw]
 *   returns   : (num_boxes, num_boxes) fp32 Monte-Carlo IoU matrix
 *
 * Computation per box pair (i, j):
 *   Box j is sampled at a fixed 4x5 = 20-point stratified grid in its local
 *   frame; sample points are rotated to the global frame. inter(i,j) is
 *   estimated as area_j * P(sample_j inside box i);
 *   IoU = inter / (area_i + area_j - inter).
 *   Deterministic sampling: bitwise-identical output for identical input.
 *
 * Vectorized shape (3-layer Reg, mirrors searchsorted):
 *   Layer 1 (__simd_vf__ NmsBevIouPairVf):
 *     The pair's 20 sample offsets live in UB as [lu*20 + lv] lanes. One vf
 *     call does broadcast FMA rotate (box j), subtract (box i center),
 *     rotate back, Abs + Compares (inside mask), Reduce<SUM> for the
 *     inside count — 20 lanes in ~10 vector instructions instead of 20 x 8
 *     scalar FMAs.
 *   Layer 2 (__aicore__ NmsBevIouPair): LocalTensor pointer bridge.
 *   Layer 3 (kernel): stages the packed boxes into UB once per block, walks
 *     its pair range calling the vf helper, stores IoU into a UB result
 *     buffer flushed back with one DataCopyPad.
 *
 * Host pre-computation:
 *   Packs each box into a (num_boxes, 8) fp32 workspace
 *   [cx, cy, cos, sin, hw, hh, dx, dy] and additionally a 20-element sample
 *   offset table [lu * dxJ, lv * dyJ] per pair is folded into the vf call by
 *   reconstructing local coords inside lanes (scale factors passed as args),
 *   so no per-pair table is materialized.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace NmsBevIou {

constexpr static int64_t NUM_SAMPLES = 20;   // 4 x 5 stratified grid
constexpr static int64_t PACK_STRIDE = 8;    // [cx, cy, cos, sin, hw, hh, dx, dy]
constexpr static int64_t MAX_PAIRS_PER_BLOCK = 256;

// ---------------------------------------------------------------------------
// 1. Schema
// ---------------------------------------------------------------------------
TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("nms_bev_iou(Tensor boxes_bev) -> Tensor");
}

// ---------------------------------------------------------------------------
// 2. Meta
// ---------------------------------------------------------------------------
torch::Tensor nms_bev_iou_meta(const torch::Tensor &boxes_bev)
{
    TORCH_CHECK(boxes_bev.dim() == 2 && boxes_bev.size(1) == 7,
                "boxes_bev must be (num_boxes, 7)");
    const auto num_boxes = boxes_bev.size(0);
    return torch::empty({num_boxes, num_boxes},
                        boxes_bev.options().dtype(torch::kFloat32));
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("nms_bev_iou", nms_bev_iou_meta);
}

// ---------------------------------------------------------------------------
// 3. Layer 1: vectorized per-pair Monte-Carlo inside-count (20 lanes)
// ---------------------------------------------------------------------------
__simd_vf__ inline void NmsBevIouPairVf(
    __ubuf__ float *sampleLocalX, __ubuf__ float *sampleLocalY,
    float cxJ, float cyJ, float cJ, float sJ,
    float cxI, float cyI, float cI, float sI, float hwI, float hhI,
    __ubuf__ float *countOutPtr)
{
    AscendC::Reg::RegTensor<float> lxReg, lyReg, tReg, uReg;
    AscendC::Reg::RegTensor<float> gxReg, gyReg, rxReg, ryReg;
    AscendC::Reg::RegTensor<float> onesReg, cntReg;
    uint32_t sampleCount = static_cast<uint32_t>(NUM_SAMPLES);
    AscendC::Reg::MaskReg validMask = AscendC::Reg::UpdateMask<float>(sampleCount);
    uint32_t scalarOne = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<float>(scalarOne);

    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(lxReg, sampleLocalX);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(lyReg, sampleLocalY);

    // Rotate box-j local samples to the global frame: gx = lx*cJ - ly*sJ + cxJ
    AscendC::Reg::Muls(gxReg, lxReg, cJ, validMask);
    AscendC::Reg::Muls(tReg, lyReg, sJ, validMask);
    AscendC::Reg::Sub(gxReg, gxReg, tReg, validMask);
    AscendC::Reg::Adds(gxReg, gxReg, cxJ, validMask);
    // gy = lx*sJ + ly*cJ + cyJ
    AscendC::Reg::Muls(gyReg, lxReg, sJ, validMask);
    AscendC::Reg::Muls(tReg, lyReg, cJ, validMask);
    AscendC::Reg::Add(gyReg, gyReg, tReg, validMask);
    AscendC::Reg::Adds(gyReg, gyReg, cyJ, validMask);

    // Translate to box-i center and rotate into its local frame
    // rx = gx - cxI ; ry = gy - cyI
    AscendC::Reg::Adds(rxReg, gxReg, -cxI, validMask);
    AscendC::Reg::Adds(ryReg, gyReg, -cyI, validMask);
    // lx' = rx*cI + ry*sI
    AscendC::Reg::Muls(lxReg, rxReg, cI, validMask);
    AscendC::Reg::Muls(tReg, ryReg, sI, validMask);
    AscendC::Reg::Add(lxReg, lxReg, tReg, validMask);
    // ly' = -rx*sI + ry*cI
    AscendC::Reg::Muls(lyReg, ryReg, cI, validMask);
    AscendC::Reg::Muls(tReg, rxReg, sI, validMask);
    AscendC::Reg::Sub(lyReg, lyReg, tReg, validMask);

    // inside = |lx'| <= hwI && |ly'| <= hhI  (two CMPMODE::LE compares, AND)
    AscendC::Reg::Abs(uReg, lxReg, validMask);
    AscendC::Reg::MaskReg maskX;
    AscendC::Reg::Compares<float, AscendC::CMPMODE::LE>(maskX, uReg, hwI, validMask);
    AscendC::Reg::Abs(uReg, lyReg, validMask);
    AscendC::Reg::MaskReg maskY;
    AscendC::Reg::Compares<float, AscendC::CMPMODE::LE>(maskY, uReg, hhI, validMask);

    AscendC::Reg::Duplicate<float, AscendC::Reg::MaskMergeMode::ZEROING>(
        onesReg, 1.0f, validMask);
    // count = sum(1 where maskX & maskY). AND via Select: ones where maskX, 0 else,
    // then Reduce with maskY.
    AscendC::Reg::RegTensor<float> selReg;
    AscendC::Reg::RegTensor<float> zeroReg;
    AscendC::Reg::Duplicate<float>(zeroReg, 0.0f, validMask);
    AscendC::Reg::Select<float>(selReg, onesReg, zeroReg, maskX);
    AscendC::Reg::Reduce<
        AscendC::Reg::ReduceType::SUM, float, float,
        AscendC::Reg::MaskMergeMode::ZEROING>(cntReg, selReg, maskY);

    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        countOutPtr, cntReg, scalarMask);
}

// Layer 2: pointer bridge
__aicore__ inline void NmsBevIouPair(
    __ubuf__ float *sampleLocalX, __ubuf__ float *sampleLocalY,
    float cxJ, float cyJ, float cJ, float sJ,
    float cxI, float cyI, float cI, float sI, float hwI, float hhI,
    __ubuf__ float *countOutPtr)
{
    asc_vf_call<NmsBevIouPairVf>(
        sampleLocalX, sampleLocalY, cxJ, cyJ, cJ, sJ,
        cxI, cyI, cI, sI, hwI, hhI, countOutPtr);
}

// ---------------------------------------------------------------------------
// 4. Layer 3: kernel
// ---------------------------------------------------------------------------
template <typename T>
__global__ __aicore__ __vector__ void nms_bev_iou_kernel(
    GM_ADDR packedGm, GM_ADDR iouGm,
    int64_t numBoxes, int64_t rowPairsPerBlock)
{
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<T> packed, iou;
    packed.SetGlobalBuffer((__gm__ T *)packedGm);
    iou.SetGlobalBuffer((__gm__ T *)iouGm);

    const int64_t blockIdx = AscendC::GetBlockIdx();
    const int64_t pairBegin = blockIdx * rowPairsPerBlock;
    const int64_t totalPairs = numBoxes * numBoxes;
    if (pairBegin >= totalPairs) {
        return;
    }
    const int64_t pairEnd = (blockIdx + 1) * rowPairsPerBlock < totalPairs
                                ? (blockIdx + 1) * rowPairsPerBlock
                                : totalPairs;
    const int64_t myPairs = pairEnd - pairBegin;

    // UB staging: packed boxes + 20-lane sample tables + count slot + results
    // sampX/sampY 各占独立 TBuf: LoadAlign 要求 32B 对齐, sampX+20 (80B) 会破坏对齐
    // (numBoxes 上界由 host 侧 TORCH_CHECK 保证: boxUb <= 2048*8*4 = 64KB)
    const int64_t boxUbElems = numBoxes * PACK_STRIDE;
    constexpr int64_t SAMP_BYTES = ((NUM_SAMPLES * sizeof(T) + 31) / 32) * 32;
    AscendC::TBuf<AscendC::TPosition::VECCALC> boxBuf, sampXBuf, sampYBuf, cntBuf, outBuf;
    pipe.InitBuffer(boxBuf, boxUbElems * sizeof(T));
    pipe.InitBuffer(sampXBuf, SAMP_BYTES);
    pipe.InitBuffer(sampYBuf, SAMP_BYTES);
    pipe.InitBuffer(cntBuf, 32);                       // one fp32 count slot
    pipe.InitBuffer(outBuf, myPairs * sizeof(T));
    auto boxUb = boxBuf.Get<T>();
    auto sampXUb = sampXBuf.Get<T>();
    auto sampYUb = sampYBuf.Get<T>();
    auto cntUb = cntBuf.Get<T>();
    auto outUb = outBuf.Get<T>();

    AscendC::DataCopyExtParams boxCp;
    boxCp.blockCount = 1;
    boxCp.blockLen = boxUbElems * sizeof(T);
    boxCp.srcStride = 0;
    boxCp.dstStride = 0;
    AscendC::DataCopyPadExtParams<T> boxPad{false, 0, 0, 0};
    AscendC::DataCopyPad(boxUb, packed, boxCp, boxPad);

    __ubuf__ T *sampX = (__ubuf__ T *)sampXUb.GetPhyAddr();
    __ubuf__ T *sampY = (__ubuf__ T *)sampYUb.GetPhyAddr();
    __ubuf__ T *cntSlot = (__ubuf__ T *)cntUb.GetPhyAddr();

    // Per-pair Monte-Carlo IoU via the vectorized helper
    const T invS = (T)1.0 / (T)NUM_SAMPLES;
    for (int64_t p = 0; p < myPairs; ++p) {
        const int64_t pair = pairBegin + p;
        const int64_t i = pair / numBoxes;   // measured box
        const int64_t j = pair % numBoxes;   // sampled box
        if (i == j) {
            outUb.SetValue(static_cast<uint32_t>(p), (T)1.0);
            continue;
        }
        const T cxI = boxUb.GetValue(i * PACK_STRIDE + 0);
        const T cyI = boxUb.GetValue(i * PACK_STRIDE + 1);
        const T cI = boxUb.GetValue(i * PACK_STRIDE + 2);
        const T sI = boxUb.GetValue(i * PACK_STRIDE + 3);
        const T hwI = boxUb.GetValue(i * PACK_STRIDE + 4);
        const T hhI = boxUb.GetValue(i * PACK_STRIDE + 5);
        const T dxi = boxUb.GetValue(i * PACK_STRIDE + 6);
        const T dyi = boxUb.GetValue(i * PACK_STRIDE + 7);

        const T cxJ = boxUb.GetValue(j * PACK_STRIDE + 0);
        const T cyJ = boxUb.GetValue(j * PACK_STRIDE + 1);
        const T cJ = boxUb.GetValue(j * PACK_STRIDE + 2);
        const T sJ = boxUb.GetValue(j * PACK_STRIDE + 3);
        const T dxJ = boxUb.GetValue(j * PACK_STRIDE + 6);
        const T dyJ = boxUb.GetValue(j * PACK_STRIDE + 7);

        // Build box-j's 20 local sample lanes: u = (2*su+1)/8-0.5, v = (2*sv+1)/10-0.5
        int64_t lane = 0;
        for (int64_t sv = 0; sv < 5; ++sv) {
            const T lv = ((T)(2 * sv + 1) / (T)10.0 - (T)0.5) * dyJ;
            for (int64_t su = 0; su < 4; ++su) {
                const T lu = ((T)(2 * su + 1) / (T)8.0 - (T)0.5) * dxJ;
                sampX[lane] = lu;
                sampY[lane] = lv;
                ++lane;
            }
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        NmsBevIouPair(sampX, sampY,
                      (float)cxJ, (float)cyJ, (float)cJ, (float)sJ,
                      (float)cxI, (float)cyI, (float)cI, (float)sI,
                      (float)hwI, (float)hhI, cntSlot);
        AscendC::PipeBarrier<PIPE_ALL>();

        const T insideCount = cntSlot[0];
        const T areaJ = dxJ * dyJ;
        const T areaI = dxi * dyi;
        const T inter = areaJ * (insideCount * invS);
        const T uni = areaI + areaJ - inter;
        outUb.SetValue(static_cast<uint32_t>(p), inter / uni);
    }

    // Flush staged results to GM
    AscendC::DataCopyExtParams outCp;
    outCp.blockCount = 1;
    outCp.blockLen = static_cast<uint32_t>(myPairs * sizeof(T));
    outCp.srcStride = 0;
    outCp.dstStride = 0;
    AscendC::DataCopyPad(iou[pairBegin], outUb, outCp);
}

// ---------------------------------------------------------------------------
// 5. Host dispatch
// ---------------------------------------------------------------------------
torch::Tensor nms_bev_iou_npu(const torch::Tensor &boxes_bev)
{
    const c10::OptionalDeviceGuard guard(boxes_bev.device());
    TORCH_CHECK(boxes_bev.dim() == 2 && boxes_bev.size(1) == 7,
                "boxes_bev must be (num_boxes, 7)");
    TORCH_CHECK(boxes_bev.scalar_type() == torch::kFloat32,
                "nms_bev_iou supports fp32 only");
    // UB 上界: boxUb = numBoxes*PACK_STRIDE*4B <= 2048*8*4 = 64KB (预算内)
    constexpr int64_t MAX_NUM_BOXES = 2048;
    TORCH_CHECK(boxes_bev.size(0) <= MAX_NUM_BOXES,
                "nms_bev_iou supports up to ", MAX_NUM_BOXES,
                " boxes per call, got ", boxes_bev.size(0));
    const int64_t numBoxes = boxes_bev.size(0);
    auto iou = nms_bev_iou_meta(boxes_bev);

    if (numBoxes == 0) {
        return iou;
    }

    // Host pre-computation: pack [cx, cy, cos, sin, hw, hh, dx, dy] per box
    auto boxesC = boxes_bev.contiguous();
    auto packed = torch::empty({numBoxes, PACK_STRIDE},
                                boxesC.options().dtype(torch::kFloat32));
    packed.select(1, 0).copy_(boxesC.select(1, 0));
    packed.select(1, 1).copy_(boxesC.select(1, 1));
    packed.select(1, 2).copy_(torch::cos(boxesC.select(1, 6)));
    packed.select(1, 3).copy_(torch::sin(boxesC.select(1, 6)));
    packed.select(1, 4).copy_(boxesC.select(1, 3) / 2.0);
    packed.select(1, 5).copy_(boxesC.select(1, 4) / 2.0);
    packed.select(1, 6).copy_(boxesC.select(1, 3));
    packed.select(1, 7).copy_(boxesC.select(1, 4));
    auto packedC = packed.contiguous();

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive.");
    const int64_t totalPairs = numBoxes * numBoxes;

    int64_t rowPairsPerBlock = (totalPairs + coreNum - 1) / coreNum;
    if (rowPairsPerBlock > MAX_PAIRS_PER_BLOCK) {
        rowPairsPerBlock = MAX_PAIRS_PER_BLOCK;
    }
    if (rowPairsPerBlock < 1) {
        rowPairsPerBlock = 1;
    }
    const int64_t numBlocks = (totalPairs + rowPairsPerBlock - 1) / rowPairsPerBlock;

    auto packed_ptr = (GM_ADDR)packedC.data_ptr();
    auto iou_ptr = (GM_ADDR)iou.data_ptr();
    auto acl_call = [=]() -> int {
        nms_bev_iou_kernel<float><<<numBlocks, nullptr, stream>>>(
            packed_ptr, iou_ptr, numBoxes, rowPairsPerBlock);
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("NmsBevIou", acl_call);
    return iou;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("nms_bev_iou", nms_bev_iou_npu);
}

} // namespace NmsBevIou
} // namespace ops_multimodal_fusion

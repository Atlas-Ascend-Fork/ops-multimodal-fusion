#include "sparse_rulebook.inc"

/*!
 * \file sparse_conv_reg.asc
 * \brief 融合 Regular 稀疏卷积 (stride 下采样) — conv2d 风格单次调用。
 *
 * torch.ops.ops_multimodal_fusion.sparse_conv_reg(
 *     Tensor features,        // (N, C_in) fp32/fp16
 *     Tensor indices,         // (N, 4) int32 (b, z, y, x)
 *     int d_out, int h_out, int w_out,
 *     Tensor weight,          // (kvol, C_in, C_out) — tap 序 k=kd*(kh*kw)+khh*kw+kww
 *     Tensor? bias,           // (C_out,) 或 None
 *     int kz = 3, int kh = 3, int kw = 3,
 *     int st0 = 2, int st1 = 2, int st2 = 2,
 *     int pd0 = 1, int pd1 = 1, int pd2 = 1,
 *     int dl0 = 1, int dl1 = 1, int dl2 = 1,
 * ) -> (Tensor out_features,  // (M, C_out) 与 features 同 dtype
 *       Tensor out_indices)   // (M, 4) int32 (b, oz, oy, ox), flat 升序
 *
 * 融合编排 (host C++, 中间量全程设备侧, Python 仅 1 次 dispatch):
 *   [1] reg_rulebook_direct: 27 tap → 输出 flat (g_flat, -1=无效; 原生 kernel v2)
 *   [2] reg_compact: at::unique → out_buf 解码 (M,3) + inv (nv,) int32
 *   [3] 全 tap GEMM: (N, C_in) @ (C_in, kvol*C_out) — fp32, 与现网路径一致
 *   [4] valid 选择: contrib (nv, C_out)
 *   [5] reg_scatter_add (默认 at::index_add_, MTE3 kernel 基座) 累加
 *   [6] out_indices: out_buf 3 列 → (b, oz, oy, ox) 4 列
 *
 * 唯一同步点: stats[0].item() 读取 M (输出张量尺寸所必需)。
 */

namespace ops_multimodal_fusion {
namespace SparseRulebook {
// 跨翻译单元复用 (sparse_rulebook.asc 导出): 拓扑段
torch::Tensor reg_rulebook_npu(const torch::Tensor &indices,
                               int64_t d_out, int64_t h_out, int64_t w_out,
                               int64_t kz, int64_t kh, int64_t kw,
                               int64_t st0, int64_t st1, int64_t st2,
                               int64_t pd0, int64_t pd1, int64_t pd2,
                               int64_t dl0, int64_t dl1, int64_t dl2,
                               int64_t transposed);
}  // namespace SparseRulebook

namespace SparseRegConv {

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("sparse_conv_reg(Tensor features, Tensor indices, "
          "int d_out, int h_out, int w_out, "
          "Tensor weight, Tensor? bias, "
          "int kz = 3, int kh = 3, int kw = 3, "
          "int st0 = 2, int st1 = 2, int st2 = 2, "
          "int pd0 = 1, int pd1 = 1, int pd2 = 1, "
          "int dl0 = 1, int dl1 = 1, int dl2 = 1) -> (Tensor, Tensor)");
    m.def("sparse_conv_reg_dbg(Tensor features, Tensor indices, "
          "int d_out, int h_out, int w_out, "
          "Tensor weight, "
          "int kz = 3, int kh = 3, int kw = 3, "
          "int st0 = 2, int st1 = 2, int st2 = 2, "
          "int pd0 = 1, int pd1 = 1, int pd2 = 1, "
          "int dl0 = 1, int dl1 = 1, int dl2 = 1) -> (Tensor, Tensor, Tensor, Tensor, Tensor)");
}

static std::tuple<torch::Tensor, torch::Tensor> sparse_conv_reg_meta(
    const torch::Tensor &features, const torch::Tensor &indices,
    int64_t d_out, int64_t h_out, int64_t w_out,
    const torch::Tensor &weight,
    const std::optional<torch::Tensor> &bias,
    int64_t kz, int64_t kh, int64_t kw,
    int64_t st0, int64_t st1, int64_t st2,
    int64_t pd0, int64_t pd1, int64_t pd2,
    int64_t dl0, int64_t dl1, int64_t dl2)
{
    // Meta 阶段 M 依赖数据去重, 不可静态推断 — 0 行占位 (前向重写)
    (void)features; (void)indices; (void)bias;
    (void)d_out; (void)h_out; (void)w_out;
    (void)kz; (void)kh; (void)kw; (void)st0; (void)st1; (void)st2;
    (void)pd0; (void)pd1; (void)pd2; (void)dl0; (void)dl1; (void)dl2;
    auto outF = at::empty({0, weight.size(2)}, features.options());
    auto outI = at::empty({0, 4}, indices.options());
    return {outF, outI};
}

static std::tuple<torch::Tensor, torch::Tensor> sparse_conv_reg_npu(
    const torch::Tensor &features, const torch::Tensor &indices,
    int64_t d_out, int64_t h_out, int64_t w_out,
    const torch::Tensor &weight,
    const std::optional<torch::Tensor> &bias,
    int64_t kz, int64_t kh, int64_t kw,
    int64_t st0, int64_t st1, int64_t st2,
    int64_t pd0, int64_t pd1, int64_t pd2,
    int64_t dl0, int64_t dl1, int64_t dl2)
{
    const c10::OptionalDeviceGuard guard(features.device());
    // ── 校验 ──
    TORCH_CHECK(features.dim() == 2, "features must be (N, C_in)");
    TORCH_CHECK(indices.dim() == 2 && indices.size(1) == 4,
                "indices must be (N, 4) int32");
    TORCH_CHECK(indices.scalar_type() == torch::kInt32, "indices must be int32");
    TORCH_CHECK(features.scalar_type() == torch::kFloat32 ||
                features.scalar_type() == torch::kFloat16,
                "features must be fp32/fp16");
    TORCH_CHECK(weight.dim() == 3, "weight must be (kvol, C_in, C_out)");
    TORCH_CHECK(kz >= 1 && kh >= 1 && kw >= 1, "kernel size >= 1");
    TORCH_CHECK(st0 > 0 && st1 > 0 && st2 > 0, "stride must be positive");
    TORCH_CHECK(pd0 >= 0 && pd1 >= 0 && pd2 >= 0, "padding must be non-negative");
    TORCH_CHECK(dl0 > 0 && dl1 > 0 && dl2 > 0, "dilation must be positive");
    TORCH_CHECK(kz * kh * kw <= 343, "kvol <= 343");
    TORCH_CHECK(d_out > 0 && h_out > 0 && w_out > 0, "output shape positive");

    const int64_t n = indices.size(0);
    const int64_t cIn = features.size(1);
    const int64_t cOut = weight.size(2);
    const int64_t kvol = kz * kh * kw;
    TORCH_CHECK(features.size(0) == n, "features/indices rows mismatch");
    TORCH_CHECK(weight.size(0) == kvol, "weight kvol mismatch");
    TORCH_CHECK(weight.size(1) == cIn, "weight C_in mismatch");
    if (bias.has_value()) {
        TORCH_CHECK(bias->dim() == 1 && bias->size(0) == cOut,
                    "bias must be (C_out,)");
    }
    if (n == 0) {
        auto outF = at::empty({0, cOut}, features.options());
        auto outI = at::empty({0, 4}, indices.options());
        return {outF, outI};
    }

    // ── [1] 拓扑: 27 tap → 输出 flat 坐标 (原生 kernel v2, 轴通过名单) ──
    const auto gFlat = SparseRulebook::reg_rulebook_npu(
        indices, d_out, h_out, w_out, kz, kh, kw,
        st0, st1, st2, pd0, pd1, pd2, dl0, dl1, dl2, 0);

    // ── [2] unique/compact (aclnn): sorted uniq + valid 序 inverse 一步 ──
    const auto vals = gFlat.masked_select(gFlat >= 0);   // (nv,) int64, 行主序
    const auto uniqRes = at::_unique(vals, true, true);
    const auto uf = std::get<0>(uniqRes);            // (M,) int64 升序
    const auto inv64 = std::get<1>(uniqRes);         // (nv,) int64 valid 序
    const int64_t mOut = uf.numel();                 // ★ 唯一同步点: M 定输出尺寸

    // ── [3] 全 tap GEMM (计算域随 features: fp32 与现网路径一致; fp16 时
    //    权重随输入 cast, 与 sparse_conv_subm 契约统一): (N,C_in)@(C_in,kvol*C_out) ──
    const auto wFlat = weight.reshape({kvol, cIn, cOut})
                           .permute({1, 0, 2})
                           .reshape({cIn, kvol * cOut})
                           .to(features.scalar_type());
    auto contribAll = at::matmul(features, wFlat).reshape({n, kvol, cOut});

    // ── [4] valid 选择: contrib (nv, C_out) — 线性序与 inv 对齐 ──
    const auto valid = gFlat.ge(0);
    const auto selLin = at::nonzero(valid.reshape(-1)).flatten().to(torch::kLong);   // (nv,)
    auto contribV = contribAll.reshape({-1, cOut}).index_select(0, selLin);

    // ── [5] scatter 累加 (aclnn InplaceIndexAdd) ──
    auto outF = at::zeros({mOut, cOut}, features.options());
    if (inv64.numel() > 0) {
        outF.index_add_(0, inv64, contribV);
    }

    // ── [6] out_indices: uf (flat) → (b, oz, oy, ox) 4 列 ──
    // flat = b*(d*h*w) + oz*(h*w) + oy*w + ox
    const auto hw = h_out * w_out;
    const auto bCol = uf / (d_out * hw);
    const auto remD = uf % (d_out * hw);
    const auto ozCol = remD / hw;
    const auto remH = remD % hw;
    const auto oyCol = remH / w_out;
    const auto oxCol = remH % w_out;
    const auto outI32 = at::stack({bCol, ozCol, oyCol, oxCol}, 1)
                            .to(torch::kInt32);

    // ── [7] bias ──
    if (bias.has_value()) {
        outF = outF + bias->to(outF.scalar_type());
    }
    return {outF, outI32};
}

static std::tuple<torch::Tensor, torch::Tensor> sparse_conv_reg_dbg_meta(
    const torch::Tensor &features, const torch::Tensor &indices,
    int64_t d_out, int64_t h_out, int64_t w_out,
    const torch::Tensor &weight,
    int64_t kz, int64_t kh, int64_t kw,
    int64_t st0, int64_t st1, int64_t st2,
    int64_t pd0, int64_t pd1, int64_t pd2,
    int64_t dl0, int64_t dl1, int64_t dl2)
{
    (void)features; (void)indices; (void)weight;
    (void)kz; (void)kh; (void)kw; (void)st0; (void)st1; (void)st2;
    (void)pd0; (void)pd1; (void)pd2; (void)dl0; (void)dl1; (void)dl2;
    auto outF = at::empty({0, weight.size(2)}, features.options());
    auto outI = at::empty({0, 4}, indices.options());
    return {outF, outI};
}

static std::tuple<torch::Tensor, torch::Tensor, torch::Tensor, torch::Tensor,
                  torch::Tensor> sparse_conv_reg_dbg(
    const torch::Tensor &features, const torch::Tensor &indices,
    int64_t d_out, int64_t h_out, int64_t w_out,
    const torch::Tensor &weight,
    int64_t kz, int64_t kh, int64_t kw,
    int64_t st0, int64_t st1, int64_t st2,
    int64_t pd0, int64_t pd1, int64_t pd2,
    int64_t dl0, int64_t dl1, int64_t dl2)
{
    const c10::OptionalDeviceGuard guard(features.device());
    const int64_t n = indices.size(0);
    const int64_t cIn = features.size(1);
    const int64_t cOut = weight.size(2);
    const int64_t kvol = kz * kh * kw;
    if (n == 0) {
        return {at::zeros({0, cOut}, features.options()),
                at::zeros({0, 4}, indices.options()),
                at::zeros({0}, indices.options().dtype(torch::kLong)),
                at::zeros({0}, indices.options().dtype(torch::kLong)),
                at::zeros({0}, indices.options().dtype(torch::kInt32))};
    }

    const auto gFlat = SparseRulebook::reg_rulebook_npu(
        indices, d_out, h_out, w_out, kz, kh, kw,
        st0, st1, st2, pd0, pd1, pd2, dl0, dl1, dl2, 0);
    const auto vals = gFlat.masked_select(gFlat >= 0);
    const auto uniqRes = at::_unique(vals, true, true);
    const auto uf = std::get<0>(uniqRes);
    const auto inv64 = std::get<1>(uniqRes);
    const auto wFlat = weight.reshape({kvol, cIn, cOut})
                           .permute({1, 0, 2})
                           .reshape({cIn, kvol * cOut});
    auto contribAll = at::matmul(features, wFlat).reshape({n, kvol, cOut});
    const auto valid = gFlat.ge(0);
    const auto selLin = at::nonzero(valid.reshape(-1)).flatten().to(torch::kLong);
    auto contribV = contribAll.reshape({-1, cOut}).index_select(0, selLin);
    auto outF = at::zeros({uf.numel(), cOut}, features.options());
    if (inv64.numel() > 0) {
        outF.index_add_(0, inv64, contribV);
    }
    return {outF, uf, inv64, selLin, gFlat};
}

static std::tuple<torch::Tensor, torch::Tensor, torch::Tensor, torch::Tensor,
                  torch::Tensor> sparse_conv_reg_dbg_impl(
    const torch::Tensor &features, const torch::Tensor &indices,
    int64_t d_out, int64_t h_out, int64_t w_out,
    const torch::Tensor &weight,
    int64_t kz, int64_t kh, int64_t kw,
    int64_t st0, int64_t st1, int64_t st2,
    int64_t pd0, int64_t pd1, int64_t pd2,
    int64_t dl0, int64_t dl1, int64_t dl2)
{
    return sparse_conv_reg_dbg(features, indices, d_out, h_out, w_out, weight,
                               kz, kh, kw, st0, st1, st2, pd0, pd1, pd2,
                               dl0, dl1, dl2);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("sparse_conv_reg", sparse_conv_reg_meta);
    m.impl("sparse_conv_reg_dbg", [=](const torch::Tensor &features,
        const torch::Tensor &indices, int64_t d_out, int64_t h_out,
        int64_t w_out, const torch::Tensor &weight, int64_t kz, int64_t kh,
        int64_t kw, int64_t st0, int64_t st1, int64_t st2, int64_t pd0,
        int64_t pd1, int64_t pd2, int64_t dl0, int64_t dl1, int64_t dl2) {
        (void)features; (void)indices; (void)d_out; (void)h_out; (void)w_out;
        (void)weight; (void)kz; (void)kh; (void)kw; (void)st0; (void)st1;
        (void)st2; (void)pd0; (void)pd1; (void)pd2; (void)dl0; (void)dl1;
        (void)dl2;
        auto eF = at::empty({0}, features.options());
        return std::make_tuple(eF, eF, eF, eF, eF);
    });
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("sparse_conv_reg", sparse_conv_reg_npu);
    m.impl("sparse_conv_reg_dbg", sparse_conv_reg_dbg_impl);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, AutogradPrivateUse1, m)
{
    m.impl("sparse_conv_reg_dbg",
           torch::CppFunction::makeFallthrough());
}

}  // namespace SparseRegConv
}  // namespace ops_multimodal_fusion
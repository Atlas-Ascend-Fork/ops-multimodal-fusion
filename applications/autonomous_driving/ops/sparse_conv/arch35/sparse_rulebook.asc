#include "sparse_rulebook.inc"

/*!
 * \file sparse_rulebook.asc
 * \brief SubM rulebook neighbour-lookup kernel (arch35, vector engine).
 *
 * torch.ops.ops_multimodal_fusion.subm_rulebook(
 *     Tensor indices,     // (N, 4) int32 — (b, z, y, x) per voxel, any order
 *     Tensor hash,        // (B*D*H*W,) int32 — zero-initialised; occupied
 *                         //   slots hold row+1 (row = index into indices)
 *     int d, int h, int w, // spatial shape (z, y, x)
 *     int kz = 3, int kh = 3, int kw = 3,   // kernel sizes (odd)
 *     int dl0 = 1, int dl1 = 1, int dl2 = 1) // dilation
 * ) -> Tensor            // (N, kvol) int32 — nb_safe: 0 = zero row / invalid,
 *                         //   1..N = neighbour row + 1 (matches the composite
 *                         //   (nb + 1).clamp(min=0) layout, feeds feat_p)
 *
 * Replaces the composite neighbour-table stage of SubM convolution:
 *   kvol-column broadcast + clamp + valid + flat + hash lookup + where
 * (5+ torch dispatches plus intermediate tensors) with one kernel launch.
 * 性能双路径 (msprof A/B): 大表 (hash > 8MB, 即 LoGoNet L1/L2) 上
 *   aclnn Index 的 gather 引擎比标量 GetValue 快 2.3-4x — 默认走
 *   at:: 组合链; 小表/小 N (L3/L4) 上单 launch kernel 反超 8 次
 *   dispatch (~2x)。SPARSE_CONV_RULEBOOK_KERNEL=1 强制走 kernel (基座)。
 * 泛化 kz/kh/kw + dilation (kvol <= 343), tap 序 k = kd*(kh*kw)+khh*kw+kww,
 * 邻域偏移 = (tap - center) * dilation, center = size/2 — 与 sparse_subm
 * 组合 kernel 及旧 3x3x3 固定版几何恒等 (默认参数下逐位兼容)。
 * The 72 MB int64 hash table of the composite becomes an int32 table the
 * host fills with torch.zeros + scatter_ (row+1), and this kernel does the
 * 27-neighbour query with boundary semantics matching CUDA spconv SubM (3x3x3):
 * out-of-range neighbours contribute the zero row (index 0).
 */


namespace ops_multimodal_fusion {
namespace SparseRulebook {

constexpr static int32_t SORT_SENTINEL = 2147483647;   // INT32_MAX (值域上界)

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("subm_rulebook(Tensor indices, Tensor hash, int d, int h, int w, "
          "int kz = 3, int kh = 3, int kw = 3, "
          "int dl0 = 1, int dl1 = 1, int dl2 = 1) -> Tensor");
    m.def("reg_rulebook(Tensor indices, int d_out, int h_out, int w_out, "
          "int kz, int kh, int kw, int st0, int st1, int st2, "
          "int pd0, int pd1, int pd2, int dl0, int dl1, int dl2, "
          "int transposed = 0) -> Tensor");
}
static torch::Tensor subm_rulebook_meta(const torch::Tensor &indices,
                                        int64_t kz, int64_t kh, int64_t kw)
{
    return torch::empty({indices.size(0), kz * kh * kw},
                        indices.options().dtype(torch::kInt32));
}

static torch::Tensor reg_rulebook_meta(const torch::Tensor &indices,
                                       int64_t kz, int64_t kh, int64_t kw)
{
    const int64_t kvol = kz * kh * kw;
    // kernel 对 (voxel, tap) 全槽位覆写 (-1 或 flat), 无需 zero 填充
    return torch::empty({indices.size(0) * kvol},
                        indices.options().dtype(torch::kInt32));
}

constexpr static int64_t SM_CHUNK_BYTES = 16 * 1024;  // out 单批字节预算 (MTE3 blockLen)

// v2 优化 (msprof: v1 ~100% 标量管, 60ns/probe):
//   [1] tap 三重循环替代 k/(kh*kw) div/mod 分解 (每体素 27×3 次 → 0 次)
//   [2] 3x3x3 dilation=1 快速路径: 内部体素 (远离边界) 免逐 tap 判界,
//       27 次独立定偏移装载可被编译器完全展开
//   [3] 自适应大批次 (≤16KB/批): MTE2/MTE3 同步次数 ~4x 降;
//       MTE3_S 往返模式 (reg_compact 同款) 消除 outUb 重写竞争
__global__ __aicore__ __vector__ void subm_rulebook_kernel(
    GM_ADDR idxGm, GM_ADDR hashGm, GM_ADDR outGm,
    int64_t numVoxels, int64_t dSize, int64_t hSize, int64_t wSize,
    int64_t kz, int64_t kh, int64_t kw,
    int64_t dl0, int64_t dl1, int64_t dl2,
    int64_t voxelsPerBlock)
{
    const int64_t blockIdx = AscendC::GetBlockIdx();
    const int64_t kvol = kz * kh * kw;
    const int64_t hw = hSize * wSize;
    const int64_t cz = kz / 2;
    const int64_t cy = kh / 2;
    const int64_t cx = kw / 2;
    const bool fast3 = (kz == 3 && kh == 3 && kw == 3 &&
                        dl0 == 1 && dl1 == 1 && dl2 == 1);
    const int64_t begin = blockIdx * voxelsPerBlock;
    const int64_t end = (begin + voxelsPerBlock) < numVoxels
                            ? (begin + voxelsPerBlock) : numVoxels;
    const int64_t myVox = end > begin ? (end - begin) : 0;

    int64_t rowsCap = SM_CHUNK_BYTES / (kvol * (int64_t)sizeof(int32_t));
    if (rowsCap > myVox) {
        rowsCap = myVox;
    }
    if (rowsCap < 1) {
        rowsCap = 1;
    }

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> idxBuf;
    pipe.InitBuffer(idxBuf, rowsCap * 4 * sizeof(int32_t));
    AscendC::TBuf<AscendC::TPosition::VECCALC> outBuf;
    pipe.InitBuffer(outBuf, rowsCap * kvol * sizeof(int32_t));
    auto idxUb = idxBuf.Get<int32_t>();
    auto outUb = outBuf.Get<int32_t>();

    AscendC::GlobalTensor<int32_t> idxT;
    idxT.SetGlobalBuffer((__gm__ int32_t *)idxGm);
    AscendC::GlobalTensor<int32_t> hashT;
    hashT.SetGlobalBuffer((__gm__ int32_t *)hashGm);
    AscendC::GlobalTensor<int32_t> outT;
    outT.SetGlobalBuffer((__gm__ int32_t *)outGm);

    if (myVox <= 0) {
        AscendC::PipeBarrier<PIPE_ALL>();
        return;
    }
    AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(0);   // 初始: 无未决 MTE3
    int64_t v = begin;
    while (v < end) {
        const int64_t rows = (v + rowsCap) <= end ? rowsCap : (end - v);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(0);  // 前批 out 已刷, outUb 可重写
        // 1) idx 批量 GM -> UB (rows×4 int32 连续)
        AscendC::DataCopyExtParams cpIn{1,
            static_cast<uint32_t>(rows * 4 * sizeof(int32_t)), 0, 0, 0};
        AscendC::DataCopyPad(idxUb, idxT[v * 4], cpIn, {false, 0, 0, 0});
        AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(0);
        // 2) 标量查表: tap 三重循环 (无 div/mod); fast3 内部体素免判界
        for (int64_t i = 0; i < rows; ++i) {
            const uint32_t i4 = static_cast<uint32_t>(i * 4);
            const int32_t b = idxUb.GetValue(i4 + 0);
            const int32_t z = idxUb.GetValue(i4 + 1);
            const int32_t y = idxUb.GetValue(i4 + 2);
            const int32_t x = idxUb.GetValue(i4 + 3);
            const int64_t bBase = static_cast<int64_t>(b) * dSize * hw;
            const uint32_t oBase = static_cast<uint32_t>(i * kvol);
            if (fast3) {
                const int64_t f = bBase + static_cast<int64_t>(z) * hw
                                + static_cast<int64_t>(y) * wSize + x;
                if (z > 0 && z < dSize - 1 && y > 0 && y < hSize - 1 &&
                    x > 0 && x < wSize - 1) {
                    int64_t k = 0;
                    for (int64_t dz = -1; dz <= 1; ++dz) {
                        for (int64_t dy = -1; dy <= 1; ++dy) {
                            for (int64_t dx = -1; dx <= 1; ++dx, ++k) {
                                outUb.SetValue(oBase + static_cast<uint32_t>(k),
                                    hashT.GetValue(static_cast<uint32_t>(
                                        f + dz * hw + dy * wSize + dx)));
                            }
                        }
                    }
                } else {
                    const bool zl = z > 0;
                    const bool zh = z < dSize - 1;
                    const bool yl = y > 0;
                    const bool yh = y < hSize - 1;
                    const bool xl = x > 0;
                    const bool xh = x < wSize - 1;
                    int64_t k = 0;
                    for (int64_t dz = -1; dz <= 1; ++dz) {
                        const bool zv = dz < 0 ? zl : (dz > 0 ? zh : true);
                        for (int64_t dy = -1; dy <= 1; ++dy) {
                            const bool yv = dy < 0 ? yl : (dy > 0 ? yh : true);
                            for (int64_t dx = -1; dx <= 1; ++dx, ++k) {
                                const bool xv = dx < 0 ? xl : (dx > 0 ? xh : true);
                                int32_t nb = 0;
                                if (zv && yv && xv) {
                                    nb = hashT.GetValue(static_cast<uint32_t>(
                                        f + dz * hw + dy * wSize + dx));
                                }
                                outUb.SetValue(oBase + static_cast<uint32_t>(k), nb);
                            }
                        }
                    }
                }
            } else {
                int64_t k = 0;
                for (int64_t kd = 0; kd < kz; ++kd) {
                    const int nz = z + static_cast<int>((kd - cz) * dl0);
                    for (int64_t khh = 0; khh < kh; ++khh) {
                        const int ny = y + static_cast<int>((khh - cy) * dl1);
                        for (int64_t kww = 0; kww < kw; ++kww, ++k) {
                            const int nx = x + static_cast<int>((kww - cx) * dl2);
                            int32_t nb = 0;
                            if (nz >= 0 && nz < dSize && ny >= 0 && ny < hSize &&
                                nx >= 0 && nx < wSize) {
                                const int64_t flat = bBase +
                                    static_cast<int64_t>(nz) * hw +
                                    static_cast<int64_t>(ny) * wSize + nx;
                                nb = hashT.GetValue(static_cast<uint32_t>(flat));
                            }
                            outUb.SetValue(oBase + static_cast<uint32_t>(k), nb);
                        }
                    }
                }
            }
        }
        AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(0);
        AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(0);
        // 3) 批量 UB -> GM (MTE3)
        AscendC::DataCopyExtParams cpOut{1,
            static_cast<uint32_t>(rows * kvol * sizeof(int32_t)), 0, 0, 0};
        AscendC::DataCopyPad(outT[v * kvol], outUb, cpOut);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(0);
        v += rows;
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

torch::Tensor subm_rulebook_direct_npu(const torch::Tensor &indices,
                                       const torch::Tensor &hash,
                                       int64_t d, int64_t h, int64_t w,
                                       int64_t kz, int64_t kh, int64_t kw,
                                       int64_t dl0, int64_t dl1, int64_t dl2);

torch::Tensor subm_rulebook_npu(const torch::Tensor &indices,
                                       const torch::Tensor &hash,
                                       int64_t d, int64_t h, int64_t w,
                                       int64_t kz, int64_t kh, int64_t kw,
                                       int64_t dl0, int64_t dl1, int64_t dl2)
{
    // batch-aware 容量检查 (与 sparse_subm 同款): kernel 寻址 bBase = b*d*h*w,
    // batch 从 indices col0 max 推出 (含一次同步, 换取通用算子的越界防护)
    int64_t batch = 0;
    if (indices.numel() > 0) {
        batch = indices.select(1, 0).max().item<int64_t>() + 1;
    }
    TORCH_CHECK(hash.numel() >= batch * d * h * w,
                "hash too small: need batch*d*h*w = ",
                batch * d * h * w, " elements");
    return subm_rulebook_direct_npu(indices, hash, d, h, w,
                                    kz, kh, kw, dl0, dl1, dl2);
}

// 免 batch 推断同步的直通入口 (供融合算子跨 TU 调用):
// 调用方保证 hash 容量 ≥ 真实 batch*d*h*w (如按 SparseConvTensor.batch_size
// 构建) — 省去 .max().item() 的 host 同步 (融合算子冷调用 0 同步的关键)。
torch::Tensor subm_rulebook_direct_npu(const torch::Tensor &indices,
                                       const torch::Tensor &hash,
                                       int64_t d, int64_t h, int64_t w,
                                       int64_t kz, int64_t kh, int64_t kw,
                                       int64_t dl0, int64_t dl1, int64_t dl2)
{
    const c10::OptionalDeviceGuard guard(indices.device());
    // 异步生命周期: 与 reg_rulebook 统一的 keepAlive 保护
    static thread_local std::vector<torch::Tensor> keepAlive;
    // 逐调用清空: 同流顺序下单调用保留即可 (累积会致长任务 OOM)
    keepAlive.clear();
    TORCH_CHECK(indices.dim() == 2 && indices.size(1) == 4,
                "indices must be (N, 4) int32");
    TORCH_CHECK(indices.scalar_type() == torch::kInt32, "indices must be int32");
    TORCH_CHECK(hash.scalar_type() == torch::kInt32, "hash must be int32");
    // v2: uint32 寻址防护 — hash 容量必须落在 int32 下标域内
    TORCH_CHECK(hash.numel() <= (1LL << 31),
                "hash too large: direct-address table must fit int32 "
                "(batch*d*h*w <= 2^31)");
    TORCH_CHECK(kz >= 1 && kh >= 1 && kw >= 1, "kernel size >= 1");
    TORCH_CHECK(kz % 2 == 1 && kh % 2 == 1 && kw % 2 == 1,
                "SubM kernel sizes must be odd");
    TORCH_CHECK(dl0 > 0 && dl1 > 0 && dl2 > 0, "dilation must be positive");
    TORCH_CHECK(kz * kh * kw <= 343, "subm_rulebook supports kvol <= 343 (7^3)");

    auto out = subm_rulebook_meta(indices, kz, kh, kw);
    const int64_t numVoxels = indices.size(0);
    if (numVoxels == 0) {
        return out;
    }

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    const int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive");

    auto idxC = indices.contiguous();
    auto hashC = hash.contiguous();
    keepAlive.push_back(idxC);
    keepAlive.push_back(hashC);

    // 性能双路径: 大表 (>2^21 项 = 8MB) 默认 at:: 组合链 (aclnn Index
    // gather 引擎, msprof 同形状快 2.3-4x); 小表单 launch kernel 优 (~2x)。
    // SPARSE_CONV_RULEBOOK_KERNEL=1 强制走 kernel (正确性基座)。
    static const bool forceRulebookKernel =
        std::getenv("SPARSE_CONV_RULEBOOK_KERNEL") != nullptr;
    constexpr int64_t RULEBOOK_TABLE_MAX = 2LL * 1024 * 1024;
    if (!forceRulebookKernel && hashC.numel() > RULEBOOK_TABLE_MAX) {
        // offsets 在 CPU 构造后一次 H2D (设备张量逐元素赋值 = 81 次 host 写)
        auto offsetsCpu = at::empty(
            {kz * kh * kw, 3}, idxC.options().device(torch::kCPU).dtype(torch::kInt64));
        int64_t row = 0;
        for (int64_t kd = 0; kd < kz; ++kd) {
            for (int64_t khh = 0; khh < kh; ++khh) {
                for (int64_t kww = 0; kww < kw; ++kww, ++row) {
                    offsetsCpu[row][0] = (kd - kz / 2) * dl0;
                    offsetsCpu[row][1] = (khh - kh / 2) * dl1;
                    offsetsCpu[row][2] = (kww - kw / 2) * dl2;
                }
            }
        }
        const auto offsets = offsetsCpu.to(idxC.device());
        const auto coords = idxC.narrow(1, 1, 3).to(torch::kLong);
        const auto nc = coords.unsqueeze(1) + offsets.unsqueeze(0);
        const auto lo = at::zeros({3}, nc.options());
        const auto hi = at::tensor({d - 1, h - 1, w - 1}, nc.options());
        const auto ncClamped = at::clamp(nc, lo, hi);
        const auto valid = at::all(nc == ncClamped, -1);
        const auto dhw = static_cast<int64_t>(d) * h * w;
        const auto nf = idxC.select(1, 0).to(torch::kLong).unsqueeze(1) * dhw
                      + ncClamped.select(2, 0) * (h * w)
                      + ncClamped.select(2, 1) * w
                      + ncClamped.select(2, 2);
        const auto zero = at::zeros({}, hashC.options());
        return at::where(valid, hashC.index({nf}), zero).to(torch::kInt32);
    }

    const int64_t numBlocks = std::min<int64_t>(coreNum, numVoxels);
    const int64_t voxelsPerBlock = (numVoxels + numBlocks - 1) / numBlocks;

    auto acl_call = [=]() -> int {
        subm_rulebook_kernel<<<numBlocks, nullptr, stream>>>(
            (GM_ADDR)idxC.data_ptr(), (GM_ADDR)hashC.data_ptr(),
            (GM_ADDR)out.data_ptr(), numVoxels, d, h, w,
            kz, kh, kw, dl0, dl1, dl2, voxelsPerBlock);
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("SubmRulebook", acl_call);
    return out;
}

// ---------------------------------------------------------------------------
// reg_rulebook: Regular (strided) sparse conv output-index computation.
// Pure sequential arithmetic (no random access) — one kernel replaces the
// ~15-dispatch torch chain (broadcast + clamp + div/mod + valid + where).
// out[v*27+k] = global output flat (b*Do*Ho*Wo + (oz*Ho+oy)*Wo + ox) or -1.
// Tap order: k = kd*(kh*kw) + khh*kw + kww (kd/khh/kww in [0, size)) —
// matches the composite kflat mapping; tap offset = +pad - tap_index.
// ---------------------------------------------------------------------------
constexpr static int64_t RB_CHUNK_BYTES = 16 * 1024;  // out 单批字节预算

// v2 优化 (msprof: v1 2828us/帧, 逐 tap div/mod + 整除判定全 27 tap):
//   [1] 每体素按轴预计算"通过名单" (整除 + 边界一次判定) — stride=2 时
//       平均仅 ~3.4/27 tap 有效 (奇偶分组原理), 无效槽位批量预填 -1
//   [2] 有效 tap 三重循环直接携带 (kd,khh,kww,oz,oy,ox), 无 div/mod 分解
//   [3] 自适应大批次 (≤16KB) + MTE3_S 往返 (subm_rulebook v2 同款)
__global__ __aicore__ __vector__ void reg_rulebook_kernel(
    GM_ADDR idxGm, GM_ADDR outGm,
    int64_t numVoxels, int64_t dOut, int64_t hOut, int64_t wOut,
    int64_t kz, int64_t kh, int64_t kw,
    int64_t st0, int64_t st1, int64_t st2,
    int64_t pd0, int64_t pd1, int64_t pd2,
    int64_t dl0, int64_t dl1, int64_t dl2,
    int64_t transposed,
    int64_t voxelsPerBlock)
{
    const int64_t blockIdx = AscendC::GetBlockIdx();
    const int64_t kvol = kz * kh * kw;
    const int64_t hw = hOut * wOut;
    const int64_t dhwo = dOut * hw;
    const int64_t begin = blockIdx * voxelsPerBlock;
    const int64_t end = (begin + voxelsPerBlock) < numVoxels
                            ? (begin + voxelsPerBlock) : numVoxels;
    const int64_t myVox = end > begin ? (end - begin) : 0;

    int64_t rowsCap = RB_CHUNK_BYTES / (kvol * (int64_t)sizeof(int32_t));
    if (rowsCap > myVox) {
        rowsCap = myVox;
    }
    if (rowsCap < 1) {
        rowsCap = 1;
    }

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> idxBuf;
    pipe.InitBuffer(idxBuf, rowsCap * 4 * sizeof(int32_t));
    AscendC::TBuf<AscendC::TPosition::VECCALC> outBuf;
    pipe.InitBuffer(outBuf, rowsCap * kvol * sizeof(int32_t));
    auto idxUb = idxBuf.Get<int32_t>();
    auto outUb = outBuf.Get<int32_t>();

    AscendC::GlobalTensor<int32_t> idxT;
    idxT.SetGlobalBuffer((__gm__ int32_t *)idxGm);
    AscendC::GlobalTensor<int32_t> outT;
    outT.SetGlobalBuffer((__gm__ int32_t *)outGm);

    if (myVox <= 0) {
        AscendC::PipeBarrier<PIPE_ALL>();
        return;
    }
    AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(0);   // 初始: 无未决 MTE3
    int64_t v = begin;
    while (v < end) {
        const int64_t rows = (v + rowsCap) <= end ? rowsCap : (end - v);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(0);  // 前批 out 已刷
        // 1) idx 批量 GM -> UB
        AscendC::DataCopyExtParams cpIn{1,
            static_cast<uint32_t>(rows * 4 * sizeof(int32_t)), 0, 0, 0};
        AscendC::DataCopyPad(idxUb, idxT[v * 4], cpIn, {false, 0, 0, 0});
        AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(0);
        // 2) 轴通过名单 + 有效 tap 写出, 无效槽位预填 -1
        int32_t tapZ[343], ozV[343], tapY[343], oyV[343], tapX[343], oxV[343];
        for (int64_t i = 0; i < rows; ++i) {
            const uint32_t i4 = static_cast<uint32_t>(i * 4);
            const int32_t b = idxUb.GetValue(i4 + 0);
            const int32_t z = idxUb.GetValue(i4 + 1);
            const int32_t y = idxUb.GetValue(i4 + 2);
            const int32_t x = idxUb.GetValue(i4 + 3);
            const int64_t bBase = static_cast<int64_t>(b) * dhwo;
            const uint32_t oBase = static_cast<uint32_t>(i * kvol);
            for (int64_t k = 0; k < kvol; ++k) {
                outUb.SetValue(oBase + static_cast<uint32_t>(k), -1);
            }
            int64_t nZ = 0;
            int64_t nY = 0;
            int64_t nX = 0;
            if (transposed == 0) {
                for (int64_t kd = 0; kd < kz; ++kd) {
                    const int32_t nzn = z + static_cast<int32_t>(pd0)
                                      - static_cast<int32_t>(kd * dl0);
                    if (nzn >= 0 && nzn % static_cast<int32_t>(st0) == 0) {
                        const int32_t oz = nzn / static_cast<int32_t>(st0);
                        if (oz < dOut) {
                            tapZ[nZ] = static_cast<int32_t>(kd);
                            ozV[nZ] = oz;
                            ++nZ;
                        }
                    }
                }
                for (int64_t khh = 0; khh < kh; ++khh) {
                    const int32_t nyn = y + static_cast<int32_t>(pd1)
                                      - static_cast<int32_t>(khh * dl1);
                    if (nyn >= 0 && nyn % static_cast<int32_t>(st1) == 0) {
                        const int32_t oy = nyn / static_cast<int32_t>(st1);
                        if (oy < hOut) {
                            tapY[nY] = static_cast<int32_t>(khh);
                            oyV[nY] = oy;
                            ++nY;
                        }
                    }
                }
                for (int64_t kww = 0; kww < kw; ++kww) {
                    const int32_t nxn = x + static_cast<int32_t>(pd2)
                                      - static_cast<int32_t>(kww * dl2);
                    if (nxn >= 0 && nxn % static_cast<int32_t>(st2) == 0) {
                        const int32_t ox = nxn / static_cast<int32_t>(st2);
                        if (ox < wOut) {
                            tapX[nX] = static_cast<int32_t>(kww);
                            oxV[nX] = ox;
                            ++nX;
                        }
                    }
                }
            } else {
                // 转置几何: out = in*stride - pad + tap*dilation (无整除约束)
                for (int64_t kd = 0; kd < kz; ++kd) {
                    const int32_t oz = z * static_cast<int32_t>(st0)
                                     - static_cast<int32_t>(pd0)
                                     + static_cast<int32_t>(kd * dl0);
                    if (oz >= 0 && oz < dOut) {
                        tapZ[nZ] = static_cast<int32_t>(kd);
                        ozV[nZ] = oz;
                        ++nZ;
                    }
                }
                for (int64_t khh = 0; khh < kh; ++khh) {
                    const int32_t oy = y * static_cast<int32_t>(st1)
                                     - static_cast<int32_t>(pd1)
                                     + static_cast<int32_t>(khh * dl1);
                    if (oy >= 0 && oy < hOut) {
                        tapY[nY] = static_cast<int32_t>(khh);
                        oyV[nY] = oy;
                        ++nY;
                    }
                }
                for (int64_t kww = 0; kww < kw; ++kww) {
                    const int32_t ox = x * static_cast<int32_t>(st2)
                                     - static_cast<int32_t>(pd2)
                                     + static_cast<int32_t>(kww * dl2);
                    if (ox >= 0 && ox < wOut) {
                        tapX[nX] = static_cast<int32_t>(kww);
                        oxV[nX] = ox;
                        ++nX;
                    }
                }
            }
            for (int64_t zi = 0; zi < nZ; ++zi) {
                for (int64_t yi = 0; yi < nY; ++yi) {
                    for (int64_t xi = 0; xi < nX; ++xi) {
                        const int64_t k = static_cast<int64_t>(tapZ[zi]) * (kh * kw)
                                        + static_cast<int64_t>(tapY[yi]) * kw
                                        + tapX[xi];
                        const int64_t flat = bBase
                            + static_cast<int64_t>(ozV[zi]) * hw
                            + static_cast<int64_t>(oyV[yi]) * wOut + oxV[xi];
                        outUb.SetValue(oBase + static_cast<uint32_t>(k),
                                       static_cast<int32_t>(flat));
                    }
                }
            }
        }
        AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(0);
        AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(0);
        // 3) 批量 UB -> GM (MTE3)
        AscendC::DataCopyExtParams cpOut{1,
            static_cast<uint32_t>(rows * kvol * sizeof(int32_t)), 0, 0, 0};
        AscendC::DataCopyPad(outT[v * kvol], outUb, cpOut);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(0);
        v += rows;
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

torch::Tensor reg_rulebook_npu(
    const torch::Tensor &indices,
    int64_t d_out, int64_t h_out, int64_t w_out,
    int64_t kz, int64_t kh, int64_t kw,
    int64_t st0, int64_t st1, int64_t st2,
    int64_t pd0, int64_t pd1, int64_t pd2,
    int64_t dl0, int64_t dl1, int64_t dl2,
    int64_t transposed)
{
    const c10::OptionalDeviceGuard guard(indices.device());
    // 异步生命周期 (工程修复, 与 sparse_subm 统一): contiguous 中间 tensor
    // 须活过 kernel 执行; 经验型保护, 正式上库应改 record_stream/确定完成点
    static thread_local std::vector<torch::Tensor> keepAlive;
    // 逐调用清空: 同流顺序下单调用保留即可 (累积会致长任务 OOM)
    keepAlive.clear();
    TORCH_CHECK(indices.dim() == 2 && indices.size(1) == 4, "indices (N, 4) int32");
    TORCH_CHECK(indices.scalar_type() == torch::kInt32, "indices must be int32");
    TORCH_CHECK(kz >= 1 && kh >= 1 && kw >= 1, "kernel size >= 1");
    TORCH_CHECK(st0 > 0 && st1 > 0 && st2 > 0, "stride must be positive");
    TORCH_CHECK(pd0 >= 0 && pd1 >= 0 && pd2 >= 0, "padding must be non-negative");
    TORCH_CHECK(dl0 > 0 && dl1 > 0 && dl2 > 0, "dilation must be positive");
    // kvol 泛化: UB 按 MAX_KVOL 分配 (kernel 内循环按实际 kvol 走)
    TORCH_CHECK(kz * kh * kw <= 343, "reg_rulebook supports kvol <= 343 (7^3)");

    // 源头值域防护: g_flat 由本 kernel 直接算成 int32, 溢出必须在此拦截
    // (batch 推导同 subm_rulebook; 上层可后续改为显式传 batch_size 免同步)
    int64_t batch = 0;
    if (indices.numel() > 0) {
        batch = indices.select(1, 0).max().item<int64_t>() + 1;
    }
    TORCH_CHECK(batch * d_out * h_out * w_out <
                    static_cast<int64_t>(SORT_SENTINEL),
                "output flat coordinate exceeds int32 range "
                "(B*D_out*H_out*W_out too large)");

    auto out = reg_rulebook_meta(indices, kz, kh, kw);
    const int64_t numVoxels = indices.size(0);
    if (numVoxels == 0) {
        return out;
    }
    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    const int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive");
    auto idxC = indices.contiguous();
    keepAlive.push_back(idxC);
    const int64_t numBlocks = std::min<int64_t>(coreNum, numVoxels);
    const int64_t voxelsPerBlock = (numVoxels + numBlocks - 1) / numBlocks;
    auto acl_call = [=]() -> int {
        reg_rulebook_kernel<<<numBlocks, nullptr, stream>>>(
            (GM_ADDR)idxC.data_ptr(), (GM_ADDR)out.data_ptr(),
            numVoxels, d_out, h_out, w_out, kz, kh, kw,
            st0, st1, st2, pd0, pd1, pd2, dl0, dl1, dl2,
            transposed, voxelsPerBlock);
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("RegRulebook", acl_call);
    return out;
}

// ---------------------------------------------------------------------------
// reg_scatter_add: out[inv[i]] += contrib[i, :] (fp32, MTE3 atomic add)
// 官方 grid_sample 同款模式: SetAtomicAdd + DataCopyPad + SetAtomicNone
// 每行 Co fp32 一次原子块加 (MTE3 硬件原子, 无 software 循环)

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("subm_rulebook", [=](const torch::Tensor &indices,
                                const torch::Tensor &hash,
                                int64_t d, int64_t h, int64_t w,
                                int64_t kz, int64_t kh, int64_t kw,
                                int64_t dl0, int64_t dl1, int64_t dl2)
                                -> torch::Tensor {
        (void)hash; (void)d; (void)h; (void)w;
        (void)dl0; (void)dl1; (void)dl2;
        return subm_rulebook_meta(indices, kz, kh, kw);
    });
    m.impl("reg_rulebook", [=](const torch::Tensor &indices,
                               int64_t d_out, int64_t h_out, int64_t w_out,
                               int64_t kz, int64_t kh, int64_t kw,
                               int64_t st0, int64_t st1, int64_t st2,
                               int64_t pd0, int64_t pd1, int64_t pd2,
                               int64_t dl0, int64_t dl1, int64_t dl2,
                               int64_t transposed)
                               -> torch::Tensor {
        (void)d_out; (void)h_out; (void)w_out;
        (void)st0; (void)st1; (void)st2; (void)pd0; (void)pd1; (void)pd2;
        (void)dl0; (void)dl1; (void)dl2; (void)transposed;
        return reg_rulebook_meta(indices, kz, kh, kw);
    });
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("subm_rulebook", subm_rulebook_npu);
    m.impl("reg_rulebook", reg_rulebook_npu);
}

} // namespace SparseRulebook
} // namespace ops_multimodal_fusion

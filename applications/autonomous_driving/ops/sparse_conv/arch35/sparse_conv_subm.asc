#include "sparse_rulebook.inc"

/*!
 * \file sparse_conv_subm.asc
 * \brief 融合 SubM 稀疏卷积 — conv2d 风格单次调用。
 *
 * torch.ops.ops_multimodal_fusion.sparse_conv_subm(
 *     Tensor features,        // (N, C_in) fp32/fp16
 *     Tensor indices,         // (N, 4) int32 (b, z, y, x)
 *     int d, int h, int w,    // spatial shape (z, y, x)
 *     Tensor weight,          // (kvol, C_in, C_out) — tap 序 k=kd*(kh*kw)+khh*kw+kww
 *     Tensor? bias,           // (C_out,) 或 None
 *     int kz = 3, int kh = 3, int kw = 3,
 *     int dl0 = 1, int dl1 = 1, int dl2 = 1,
 *     int cache_token = 0,    // >0: 帧代数令牌, 同 (token,shape,kernel,indices)
 *                             //     命中缓存时跳过 hash+rulebook (第 2 个同尺度
 *                             //     SubM 层免重算); 0: 禁用缓存
 *     int batch_size = 0)     // >0: 调用方已知 batch (如 SparseConvTensor.
 *                             //     batch_size) — 免 host 推断同步; 0: 从
 *                             //     indices[:,0].max() 推断 (含一次同步)
 * ) -> (Tensor out_features,  // (N, C_out) 与 features 同 dtype — SubM 活跃集合不变
 *       Tensor out_indices)   // 输入 indices 原样返回 (别名)
 *
 * 融合编排 (host C++, 中间量全程设备侧, Python 仅 1 次 dispatch):
 *   [1] hash 构建 (at::) + 拓扑: 复用 subm_rulebook_npu — 原生 kernel (小表)
 *       / at:: 组合链 (大表, aclnn Index gather 引擎), msprof 实测双路径分发
 *   [2] gather: feat_p[0] 零行 + index_select (零填充技巧, 0=无效邻居)
 *   [3] GEMM: at::matmul (aclnn, fp16 计算域) — 原生 AIC kernel 实测慢 63x,
 *       K/N 16 对齐 pad 沿用已验证路径; SPARSE_CONV_RULEBOOK_KERNEL=1
 *       强制 rulebook 走 kernel (基座)
 *
 * 契约: weight 布局与 subm_rulebook tap 序一致; batch 由 indices[:,0] 推断
 * (含一次 host 同步, 与分立调用路径一致); cache_token 语义见上。
 */

namespace ops_multimodal_fusion {
namespace SparseRulebook {
// 跨翻译单元复用 (sparse_rulebook.asc 导出): 免同步直通入口 —
// 调用方保证 hash 容量 ≥ 真实 batch*d*h*w (大小表自适应分发在内部)
torch::Tensor subm_rulebook_direct_npu(const torch::Tensor &indices,
                                       const torch::Tensor &hash,
                                       int64_t d, int64_t h, int64_t w,
                                       int64_t kz, int64_t kh, int64_t kw,
                                       int64_t dl0, int64_t dl1, int64_t dl2);
}  // namespace SparseRulebook

namespace SparseSubmConv {

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("sparse_conv_subm(Tensor features, Tensor indices, int d, int h, int w, "
          "Tensor weight, Tensor? bias, "
          "int kz = 3, int kh = 3, int kw = 3, "
          "int dl0 = 1, int dl1 = 1, int dl2 = 1, "
          "int cache_token = 0, int batch_size = 0) -> (Tensor, Tensor)");
}

static std::tuple<torch::Tensor, torch::Tensor> sparse_conv_subm_meta(
    const torch::Tensor &features, const torch::Tensor &indices,
    int64_t d, int64_t h, int64_t w,
    const torch::Tensor &weight,
    const std::optional<torch::Tensor> &bias,
    int64_t kz, int64_t kh, int64_t kw,
    int64_t dl0, int64_t dl1, int64_t dl2,
    int64_t cache_token, int64_t batch_size)
{
    (void)d; (void)h; (void)w; (void)bias;
    (void)kz; (void)kh; (void)kw; (void)dl0; (void)dl1; (void)dl2;
    (void)cache_token; (void)batch_size;
    auto outF = at::empty({indices.size(0), weight.size(2)},
                          features.options());
    return {outF, indices};
}

static std::tuple<torch::Tensor, torch::Tensor> sparse_conv_subm_npu(
    const torch::Tensor &features, const torch::Tensor &indices,
    int64_t d, int64_t h, int64_t w,
    const torch::Tensor &weight,
    const std::optional<torch::Tensor> &bias,
    int64_t kz, int64_t kh, int64_t kw,
    int64_t dl0, int64_t dl1, int64_t dl2,
    int64_t cache_token, int64_t batch_size)
{
    const c10::OptionalDeviceGuard guard(features.device());
    // ── 校验 ──
    TORCH_CHECK(features.dim() == 2, "features must be (N, C_in)");
    TORCH_CHECK(indices.dim() == 2 && indices.size(1) == 4,
                "indices must be (N, 4) int32");
    TORCH_CHECK(indices.scalar_type() == torch::kInt32, "indices must be int32");
    TORCH_CHECK(features.scalar_type() == torch::kFloat32 ||
                features.scalar_type() == torch::kFloat16,
                "features must be fp32/fp16");
    TORCH_CHECK(weight.dim() == 3, "weight must be (kvol, C_in, C_out)");
    TORCH_CHECK(kz >= 1 && kh >= 1 && kw >= 1, "kernel size >= 1");
    TORCH_CHECK(kz % 2 == 1 && kh % 2 == 1 && kw % 2 == 1,
                "SubM kernel sizes must be odd");
    TORCH_CHECK(dl0 > 0 && dl1 > 0 && dl2 > 0, "dilation must be positive");
    TORCH_CHECK(kz * kh * kw <= 343, "kvol <= 343");
    TORCH_CHECK(d > 0 && h > 0 && w > 0, "spatial shape must be positive");

    const int64_t n = indices.size(0);
    const int64_t cIn = features.size(1);
    const int64_t cOut = weight.size(2);
    const int64_t kvol = kz * kh * kw;
    TORCH_CHECK(features.size(0) == n, "features/indices rows mismatch");
    TORCH_CHECK(weight.size(0) == kvol, "weight kvol mismatch");
    TORCH_CHECK(weight.size(1) == cIn, "weight C_in mismatch");
    if (bias.has_value()) {
        TORCH_CHECK(bias->dim() == 1 && bias->size(0) == cOut,
                    "bias must be (C_out,)");
    }
    if (n == 0) {
        auto outF = at::empty({0, cOut}, features.options());
        return {outF, indices};
    }

    // ── [1] 拓扑: hash 构建 + subm_rulebook (含帧内缓存) ──
    using CacheKey = std::tuple<int64_t, int64_t, int64_t, int64_t,
                                int64_t, int64_t, int64_t, int64_t,
                                int64_t, int64_t, int64_t, int64_t>;
    static thread_local std::map<CacheKey, torch::Tensor> submCache;
    torch::Tensor nbSafe;   // (N, kvol) int32: 0=零行, 1..N=行号+1
    bool fromCache = false;
    CacheKey key{};
    if (cache_token > 0) {
        key = CacheKey(cache_token, d, h, w, kz, kh, kw, dl0, dl1, dl2,
                       reinterpret_cast<int64_t>(indices.data_ptr()), n);
        auto it = submCache.find(key);
        if (it != submCache.end()) {
            nbSafe = it->second;
            fromCache = true;
        }
    }
    if (!fromCache) {
        // batch 来源: 调用方已知 (batch_size>0, 免同步) 或推断 (含一次同步)
        const int64_t batch = batch_size > 0
            ? batch_size
            : indices.select(1, 0).max().item<int64_t>() + 1;
        auto hashTable = at::zeros({batch * d * h * w},
                                   indices.options().dtype(torch::kInt32));
        const auto idxL = indices.to(torch::kLong);
        const auto flat = idxL.select(1, 0) * (d * h * w)
                        + idxL.select(1, 1) * (h * w)
                        + idxL.select(1, 2) * w
                        + idxL.select(1, 3);
        hashTable.scatter_(0, flat,
                           at::arange(1, n + 1, hashTable.options()));
        nbSafe = SparseRulebook::subm_rulebook_direct_npu(
            indices, hashTable, d, h, w, kz, kh, kw, dl0, dl1, dl2);
        if (cache_token > 0) {
            if (submCache.size() > 8) {
                submCache.clear();
            }
            submCache[key] = nbSafe;
        }
    }

    // ── [2] gather: 零行填充 + index_select (0=无效邻居 → 零特征) ──
    const auto optsH = features.options().dtype(torch::kFloat16);
    auto featP = at::zeros({n + 1, cIn}, optsH);
    featP.narrow(0, 1, n).copy_(features);
    const auto nb64 = nbSafe.reshape(-1).to(torch::kLong);
    auto gathered = featP.index_select(0, nb64).reshape({n, kvol * cIn});

    // ── [3] GEMM: at::matmul (aclnn) + K/N 16 对齐 pad (已验证路径) ──
    const int64_t kc = kvol * cIn;
    const int64_t kPad = (kc + 15) / 16 * 16;
    const int64_t nPad = (n + 15) / 16 * 16;
    if (kPad != kc) {
        gathered = at::constant_pad_nd(gathered, {0, kPad - kc, 0, nPad - n},
                                       0.0);
    } else if (nPad != n) {
        gathered = at::constant_pad_nd(gathered, {0, 0, 0, nPad - n}, 0.0);
    }
    auto w2 = weight.reshape({kc, cOut}).to(torch::kFloat16);
    if (kPad != kc) {
        w2 = at::constant_pad_nd(w2, {0, 0, 0, kPad - kc}, 0.0);
    }
    auto outH = at::matmul(gathered, w2);
    if (bias.has_value()) {
        outH = outH + bias->to(torch::kFloat16);
    }
    auto outF = outH.narrow(0, 0, n).to(features.scalar_type());
    return {outF, indices};
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("sparse_conv_subm", sparse_conv_subm_meta);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("sparse_conv_subm", sparse_conv_subm_npu);
}

}  // namespace SparseSubmConv
}  // namespace ops_multimodal_fusion
